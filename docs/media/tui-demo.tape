# Regenerate with: task docs:demo
Output docs/media/tui-demo.gif

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 640
Set Padding 16
Set TypingSpeed 60ms
Set Theme "Catppuccin Mocha"

Hide
Type "export PS1='$ ' && export PATH=$PWD/dist:$PATH && clear"
Enter
Show

Type "tf-slate /tmp/tfdemo"
Sleep 500ms
Enter
Sleep 2s

Down
Sleep 700ms
Up
Sleep 700ms
Type "z"
Sleep 1800ms
Type "z"
Sleep 1s
Enter
Sleep 1.5s

Down 3
Sleep 700ms
Up 3
Sleep 600ms
Enter
Sleep 2s

Down
Sleep 800ms
Escape
Sleep 800ms
Escape
Sleep 800ms
Type "q"
Sleep 1s
